# Copy to .env. Only POSTGRES_PASSWORD must be changed before the first start.

# ---- required ----
# Letters and digits only. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# ---- network ----
# By default the panel is reachable only from this machine. For a public site, use the `https` profile and a domain.
WIA_BIND=127.0.0.1
WIA_PORT=8000
WIA_DOMAIN=
# Send session cookies only over HTTPS. Browsers accept this on 127.0.0.1. Keep it on.
WIA_COOKIE_SECURE=true
# Set to true only behind your own reverse proxy (the `https` profile), so rate limits see real visitor addresses.
WIA_TRUST_PROXY=false

# ---- secrets ----
# Signs admin sessions. If empty, one is generated and kept in this install's database.
WIA_SECRET_KEY=

# ---- local models (all optional: with none, answers quote the site's own text) ----
# none | ollama | llamacpp. Can also be changed from the dashboard.
WIA_LLM_BACKEND=none
WIA_LLM_MODEL=
WIA_LLM_TIMEOUT=180
# Set WIA_EMBED_BACKEND=ollama after `docker compose exec ollama ollama pull bge-m3` for semantic search.
WIA_EMBED_BACKEND=none
WIA_EMBED_MODEL=bge-m3
# sql (no extra service, small sites) | qdrant (larger sites)
WIA_VECTOR_BACKEND=qdrant
WIA_QDRANT_API_KEY=

# ---- crawler ----
WIA_CRAWLER_DELAY=1.0
WIA_COMPETITOR_DELAY=3.0
WIA_CRAWLER_MAX_PAGES=500
# Render JavaScript with Playwright. The image must be built with the `js` extra and `playwright install chromium`.
WIA_CRAWLER_JS=false
# Hosts exempt from the private-address block, comma separated. Leave empty unless you crawl a site on your own LAN.
WIA_CRAWLER_ALLOW_HOSTS=

# ---- behaviour and privacy ----
WIA_CHAT_RATE_LIMIT=30
WIA_CONVERSATION_RETENTION_DAYS=30
WIA_VOLATILE_TTL_HOURS=24
