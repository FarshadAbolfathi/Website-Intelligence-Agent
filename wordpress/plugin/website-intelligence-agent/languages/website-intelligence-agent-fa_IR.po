msgstr "امتیاز"

msgid "coverage"
msgstr "پوشش"

msgid "Latest documents"
msgstr "آخرین اسناد"

msgid "Title"
msgstr "عنوان"

msgid "Type"
msgstr "نوع"

msgid "Language"
msgstr "زبان"

msgid "Checked"
msgstr "بررسی‌شده در"

msgid "Add a question and answer"
msgstr "افزودن پرسش و پاسخ"

msgid "Your own answers are used before anything else. Keywords are optional, comma separated."
msgstr "پاسخ‌های شما پیش از هر چیز دیگری استفاده می‌شوند. کلیدواژه‌ها اختیاری‌اند و با ویرگول جدا می‌شوند."

