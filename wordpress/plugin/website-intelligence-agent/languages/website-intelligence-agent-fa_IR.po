msgid "Site Assistant"
msgstr "دستیار سایت"

msgid "Scan finished."
msgstr "بررسی سایت تمام شد."

msgid "The scan stopped because of a connection error. It will continue in the background."
msgstr "بررسی به‌دلیل خطای ارتباطی متوقف شد و در پس‌زمینه ادامه پیدا می‌کند."

msgid "Status"
